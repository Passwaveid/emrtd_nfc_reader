{
  "suite": "tlv",
  "schemaVersion": 1,
  "description": "Foundations: byte/hex helpers, asn1Length/toAsn1Length, TlvRecord (TKBERTLVRecord replacement), wrapDO/unwrapDO, DER OID encoding, ISO 9797-1 method-2 padding.",
  "runners": [
    "dart",
    "swift"
  ],
  "cases": [
    {
      "name": "asn1Length 00 -> (0, 1)",
      "op": "asn1Length",
      "input": {
        "data": "00"
      },
      "expect": {
        "out": {
          "length": 0,
          "lengthBytes": 1
        }
      }
    },
    {
      "name": "asn1Length 7f -> (127, 1)",
      "op": "asn1Length",
      "input": {
        "data": "7f"
      },
      "expect": {
        "out": {
          "length": 127,
          "lengthBytes": 1
        }
      }
    },
    {
      "name": "asn1Length 8180 -> (128, 2)",
      "op": "asn1Length",
      "input": {
        "data": "8180"
      },
      "expect": {
        "out": {
          "length": 128,
          "lengthBytes": 2
        }
      }
    },
    {
      "name": "asn1Length 81ff -> (255, 2)",
      "op": "asn1Length",
      "input": {
        "data": "81ff"
      },
      "expect": {
        "out": {
          "length": 255,
          "lengthBytes": 2
        }
      }
    },
    {
      "name": "asn1Length 820100 -> (256, 3)",
      "op": "asn1Length",
      "input": {
        "data": "820100"
      },
      "expect": {
        "out": {
          "length": 256,
          "lengthBytes": 3
        }
      }
    },
    {
      "name": "asn1Length 82ffff -> (65535, 3)",
      "op": "asn1Length",
      "input": {
        "data": "82ffff"
      },
      "expect": {
        "out": {
          "length": 65535,
          "lengthBytes": 3
        }
      }
    },
    {
      "name": "asn1Length ignores trailing garbage",
      "op": "asn1Length",
      "input": {
        "data": "05ffffffff"
      },
      "expect": {
        "out": {
          "length": 5,
          "lengthBytes": 1
        }
      }
    },
    {
      "name": "asn1Length rejects indefinite form 0x80",
      "op": "asn1Length",
      "input": {
        "data": "80"
      },
      "expect": {
        "error": "CannotDecodeASN1Length"
      }
    },
    {
      "name": "asn1Length rejects 0x83 three-byte form",
      "op": "asn1Length",
      "input": {
        "data": "83010000"
      },
      "expect": {
        "error": "CannotDecodeASN1Length"
      }
    },
    {
      "name": "asn1Length truncated 0x82 throws (upstream crashes)",
      "op": "asn1Length",
      "runners": [
        "dart"
      ],
      "input": {
        "data": "8201"
      },
      "expect": {
        "error": "CannotDecodeASN1Length"
      }
    },
    {
      "name": "asn1Length truncated 0x81 throws (upstream crashes)",
      "op": "asn1Length",
      "runners": [
        "dart"
      ],
      "input": {
        "data": "81"
      },
      "expect": {
        "error": "CannotDecodeASN1Length"
      }
    },
    {
      "name": "asn1Length empty input throws (upstream crashes)",
      "op": "asn1Length",
      "runners": [
        "dart"
      ],
      "input": {
        "data": ""
      },
      "expect": {
        "error": "CannotDecodeASN1Length"
      }
    },
    {
      "name": "toAsn1Length 0 -> 00",
      "op": "toAsn1Length",
      "input": {
        "length": 0
      },
      "expect": {
        "out": {
          "data": "00"
        }
      }
    },
    {
      "name": "toAsn1Length 127 -> 7f",
      "op": "toAsn1Length",
      "input": {
        "length": 127
      },
      "expect": {
        "out": {
          "data": "7f"
        }
      }
    },
    {
      "name": "toAsn1Length 128 -> 8180",
      "op": "toAsn1Length",
      "input": {
        "length": 128
      },
      "expect": {
        "out": {
          "data": "8180"
        }
      }
    },
    {
      "name": "toAsn1Length 255 -> 81ff",
      "op": "toAsn1Length",
      "input": {
        "length": 255
      },
      "expect": {
        "out": {
          "data": "81ff"
        }
      }
    },
    {
      "name": "toAsn1Length 256 -> 820100",
      "op": "toAsn1Length",
      "input": {
        "length": 256
      },
      "expect": {
        "out": {
          "data": "820100"
        }
      }
    },
    {
      "name": "toAsn1Length 65535 -> 82ffff",
      "op": "toAsn1Length",
      "input": {
        "length": 65535
      },
      "expect": {
        "out": {
          "data": "82ffff"
        }
      }
    },
    {
      "name": "toAsn1Length 65536 exceeds cap",
      "op": "toAsn1Length",
      "input": {
        "length": 65536
      },
      "expect": {
        "error": "InvalidASN1Value"
      }
    },
    {
      "name": "toAsn1Length -1 throws (upstream emits garbage)",
      "op": "toAsn1Length",
      "runners": [
        "dart"
      ],
      "input": {
        "length": -1
      },
      "expect": {
        "error": "InvalidASN1Value"
      }
    },
    {
      "name": "tlvRecord encode (0x80, empty) -> 80 00",
      "op": "tlvRecord.encode",
      "input": {
        "tag": "80",
        "value": ""
      },
      "expect": {
        "out": {
          "data": "8000"
        }
      }
    },
    {
      "name": "tlvRecord encode two-byte tag 0x7F49",
      "op": "tlvRecord.encode",
      "input": {
        "tag": "7f49",
        "value": "aa"
      },
      "expect": {
        "out": {
          "data": "7f4901aa"
        }
      }
    },
    {
      "name": "tlvRecord fromRecords PACE shape 7F49 { 06 oid, 86 pubkey }",
      "op": "tlvRecord.fromRecords",
      "input": {
        "tag": "7f49",
        "records": [
          {
            "tag": "06",
            "value": "04007f00070202040202"
          },
          {
            "tag": "86",
            "value": "0405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f4041424344"
          }
        ]
      },
      "expect": {
        "out": {
          "data": "7f494f060a04007f0007020204020286410405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f4041424344"
        }
      }
    },
    {
      "name": "tlvRecord parse 80 00 round-trip",
      "op": "tlvRecord.parse",
      "input": {
        "data": "8000"
      },
      "expect": {
        "out": {
          "record": {
            "tag": "80",
            "value": ""
          }
        }
      }
    },
    {
      "name": "tlvRecord parse two-byte tag round-trip",
      "op": "tlvRecord.parse",
      "input": {
        "data": "7f4901aa"
      },
      "expect": {
        "out": {
          "record": {
            "tag": "7f49",
            "value": "aa"
          }
        }
      }
    },
    {
      "name": "tlvRecord parse PACE shape round-trip",
      "op": "tlvRecord.parse",
      "input": {
        "data": "7f494f060a04007f0007020204020286410405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f4041424344"
      },
      "expect": {
        "out": {
          "record": {
            "tag": "7f49",
            "value": "060a04007f0007020204020286410405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f4041424344"
          }
        }
      }
    },
    {
      "name": "tlvRecord sequenceOfRecords over PACE 7C-wrapped response",
      "op": "tlvRecord.sequenceOfRecords",
      "input": {
        "data": "7c0c8004aabbccdd8104deadbeef"
      },
      "expect": {
        "out": {
          "records": [
            {
              "tag": "7c",
              "value": "8004aabbccdd8104deadbeef"
            }
          ]
        }
      }
    },
    {
      "name": "tlvRecord sequenceOfRecords over 7C value (two records)",
      "op": "tlvRecord.sequenceOfRecords",
      "input": {
        "data": "8004aabbccdd8104deadbeef"
      },
      "expect": {
        "out": {
          "records": [
            {
              "tag": "80",
              "value": "aabbccdd"
            },
            {
              "tag": "81",
              "value": "deadbeef"
            }
          ]
        }
      }
    },
    {
      "name": "tlvRecord sequenceOfRecords empty input -> []",
      "op": "tlvRecord.sequenceOfRecords",
      "input": {
        "data": ""
      },
      "expect": {
        "out": {
          "records": []
        }
      }
    },
    {
      "name": "tlvRecord sequenceOfRecords truncated -> null",
      "op": "tlvRecord.sequenceOfRecords",
      "input": {
        "data": "8004aabbccdd8104deadbeef8102aa"
      },
      "expect": {
        "out": {
          "records": null
        }
      }
    },
    {
      "name": "tlvRecord parse length form 0x81 (129 bytes)",
      "op": "tlvRecord.parse",
      "input": {
        "data": "8781810102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f8081"
      },
      "expect": {
        "out": {
          "record": {
            "tag": "87",
            "value": "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f8081"
          }
        }
      }
    },
    {
      "name": "tlvRecord parse length form 0x82 (256 bytes)",
      "op": "tlvRecord.parse",
      "input": {
        "data": ""
      },
      "expect": {
        "out": {
          "record": {
            "tag": "87",
            "value": ""
          }
        }
      }
    },
    {
      "name": "tlvRecord parse length form 0x83 (non-minimal BER, 256 bytes)",
      "op": "tlvRecord.parse",
      "input": {
        "data": ""
      },
      "expect": {
        "out": {
          "record": {
            "tag": "87",
            "value": ""
          }
        }
      }
    },
    {
      "name": "tlvRecord parse length form 0x84 (non-minimal BER, 256 bytes)",
      "op": "tlvRecord.parse",
      "input": {
        "data": ""
      },
      "expect": {
        "out": {
          "record": {
            "tag": "87",
            "value": ""
          }
        }
      }
    },
    {
      "name": "tlvRecord parse rejects length form 0x85 (dart): port stops at 0x84",
      "op": "tlvRecord.parse",
      "runners": [
        "dart"
      ],
      "input": {
        "data": "87850000000001aa"
      },
      "expect": {
        "out": {
          "record": null
        }
      }
    },
    {
      "name": "tlvRecord parse accepts length form 0x85 (swift): TKBERTLVRecord takes longer length forms",
      "op": "tlvRecord.parse",
      "runners": [
        "swift"
      ],
      "input": {
        "data": "87850000000001aa"
      },
      "expect": {
        "out": {
          "record": {
            "tag": "87",
            "value": "aa"
          }
        }
      }
    },
    {
      "name": "tlvRecord parse rejects indefinite length 0x80",
      "op": "tlvRecord.parse",
      "input": {
        "data": "8780aabb0000"
      },
      "expect": {
        "out": {
          "record": null
        }
      }
    },
    {
      "name": "tlvRecord parse truncated value -> null",
      "op": "tlvRecord.parse",
      "input": {
        "data": "8705aabb"
      },
      "expect": {
        "out": {
          "record": null
        }
      }
    },
    {
      "name": "tlvRecord parse truncated multi-byte tag -> null",
      "op": "tlvRecord.parse",
      "input": {
        "data": "7f"
      },
      "expect": {
        "out": {
          "record": null
        }
      }
    },
    {
      "name": "wrapDO 0x87 value size 1",
      "op": "wrapDO",
      "input": {
