        "oid": "0.4.0.127.0.7.2.2.3.1.1"
      },
      "expect": {
        "out": {
          "keyAgreementAlgorithm": "DH",
          "cipherAlgorithm": "DESede",
          "keyLength": 128,
          "protocolOIDString": "id-CA-DH-3DES-CBC-CBC"
        }
      }
    },
