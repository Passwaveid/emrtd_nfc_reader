{
  "suite": "apdu",
  "schemaVersion": 1,
  "description": "Transport/APDU layer: CommandAPDU wire encoder (canonical minimal form - dart-only, CoreNFC never exposed wire bytes), raw-APDU parser (malformed input -> typed errors), send() SW truth table (the corrected status check split by runner; the 6C exact-length retry and the 62 82 end-of-file tolerance dart-only), decodeError table (two rows corrected; private upstream -> dart-only), and TagReader command constructors (structured fields; wires pinned by the sibling encode cases).",
  "runners": [
    "dart",
    "swift"
  ],
  "cases": [
    {
      "name": "encode case-1: header only, no data no Le",
      "op": "apdu.encode",
      "runners": [
        "dart"
      ],
      "input": {
        "cla": "00",
        "ins": "84",
        "p1": "00",
        "p2": "00",
        "data": "",
        "le": -1
      },
      "expect": {
        "out": {
          "wire": "00840000"
        }
      }
    },
    {
      "name": "encode case-2 short: GET CHALLENGE Le=8",
      "op": "apdu.encode",
