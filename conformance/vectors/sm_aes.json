{
  "suite": "sm_aes",
  "schemaVersion": 1,
  "description": "AES secure messaging frozen reference (P11's only protected-APDU worked example is App D's 3DES, so AES expected values are generated from the port's deterministic protect/decrypt direction and cross-checked against OpenSSL AES-CMAC/AES-CBC; the Swift original re-verifies at session S2). Covers the AES IV derivation, post-PACE SSC init, the response-MAC and DO99-check split cases (upstream accepts what dart rejects), the malformed-RAPDU error set (the typed rejections - one the Ukrainian field shape - and dart-only guards against malformed lengths), the short-response salvage, and SSC lockstep on error SWs. Keys are fixed synthetic AES-128 session keys.",
  "runners": [
    "dart",
    "swift"
  ],
  "cases": [
    {
      "name": "first wrapped command after PACE - SSC starts at zero, AES IV = E(KSenc, 0^8 || SSC)",
      "op": "sm.protect",
      "input": {
        "algo": "AES",
        "ksenc": "f5f0e35c0d7161ee6724ee513a0d9a7f",
        "ksmac": "fe251c7858b356b24514b3bd5f4297d1",
        "ssc": "0000000000000000",
        "cmd": {
          "cla": "00",
          "ins": "a4",
          "p1": "04",
          "p2": "0c",
          "data": "a0000002471001",
          "le": null
        }
      },
      "expect": {
        "out": {
          "cla": "0c",
          "ins": "a4",
          "p1": "04",
          "p2": "0c",
          "data": "871101752f676b09fac86a87d632749a49c7cc8e08c18ba1fce707bd9f",
          "le": 256
        }
      }
    },
    {
      "name": "AES protect READ BINARY Le=A0: DO97 + 16-byte-block header padding, CMAC truncated to 8",
      "op": "sm.protect",
      "input": {
        "algo": "AES",
        "ksenc": "f5f0e35c0d7161ee6724ee513a0d9a7f",
        "ksmac": "fe251c7858b356b24514b3bd5f4297d1",
        "ssc": "0000000000000005",
        "cmd": {
          "cla": "00",
          "ins": "b0",
          "p1": "00",
          "p2": "00",
          "data": "",
          "le": 160
        }
      },
      "expect": {
        "out": {
          "cla": "0c",
          "ins": "b0",
          "p1": "00",
          "p2": "00",
          "data": "9701a08e087aa7b41953ca432c",
          "le": 256
        }
      }
    },
    {
      "name": "AES unprotect: DO87 + DO99 + DO8E round-trip (IV recomputed per call)",
      "op": "sm.unprotect",
      "input": {
        "algo": "AES",
        "ksenc": "f5f0e35c0d7161ee6724ee513a0d9a7f",
        "ksmac": "fe251c7858b356b24514b3bd5f4297d1",
        "ssc": "0000000000000006",
        "rapdu": {
          "data": "87210106b568ca5447c5a94067356bb65e585a39b2793f072b203453804278ba8ad797990290008e08a1075bfa55324bde",
          "sw": "9000"
        }
      },
      "expect": {
        "out": {
          "data": "60145f0104303130365f36063034303030305c026175",
          "sw": "9000"
        }
      }
    },
    {
      "name": "response MAC split (dart): tampered DO8E MAC -> InvalidResponseChecksum",
      "op": "sm.unprotect",
      "runners": [
        "dart"
      ],
      "input": {
        "algo": "AES",
        "ksenc": "f5f0e35c0d7161ee6724ee513a0d9a7f",
        "ksmac": "fe251c7858b356b24514b3bd5f4297d1",
        "ssc": "0000000000000006",
        "rapdu": {
          "data": "87210106b568ca5447c5a94067356bb65e585a39b2793f072b203453804278ba8ad797990290008e08a1075bfa55324b21",
          "sw": "9000"
        }
      },
      "expect": {
        "error": "InvalidResponseChecksum"
      }
    },
    {
      "name": "response MAC split (swift): tampered DO8E MAC accepted - CCb reassigned from the received CC, comparison is CC == CC",
      "op": "sm.unprotect",
      "runners": [
        "swift"
      ],
      "input": {
        "algo": "AES",
        "ksenc": "f5f0e35c0d7161ee6724ee513a0d9a7f",
        "ksmac": "fe251c7858b356b24514b3bd5f4297d1",
        "ssc": "0000000000000006",
        "rapdu": {
          "data": "87210106b568ca5447c5a94067356bb65e585a39b2793f072b203453804278ba8ad797990290008e08a1075bfa55324b21",
          "sw": "9000"
        }
      },
      "expect": {
        "out": {
          "data": "60145f0104303130365f36063034303030305c026175",
          "sw": "9000"
        }
      }
    },
    {
      "name": "DO99 check split (dart): right-tag/wrong-length DO99 (99 01) rejected as SM error -> empty data + embedded SW",
      "op": "sm.unprotect",
      "runners": [
