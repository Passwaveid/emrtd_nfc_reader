      },
      "expect": {
        "out": {
          "data": "",
          "sw": "9000"
        }
      }
    },
    {
      "name": "DO99 check split (swift): wrong-length DO99 passes the && check and decrypts normally (MAC valid over the malformed DO99, isolating the DO99 check from the MAC check)",
      "op": "sm.unprotect",
      "runners": [
        "swift"
      ],
      "input": {
        "algo": "AES",
        "ksenc": "f5f0e35c0d7161ee6724ee513a0d9a7f",
