        "ssc": "887022120c06c226",
        "exchanges": [
          {
            "cmd": {
              "cla": "00",
              "ins": "a4",
              "p1": "02",
              "p2": "0c",
              "data": "011e",
              "le": null
            },
            "rapdu": {
              "data": "990290008e08fa855a5d4c50a8ed",
              "sw": "9000"
            }
          },
          {
            "cmd": {
              "cla": "00",
              "ins": "b0",
              "p1": "00",
              "p2": "00",
              "data": "",
              "le": 4
