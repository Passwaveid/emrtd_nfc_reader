          }
        ]
      },
      "expect": {
        "out": {
          "exchanges": [
            {
              "cmd": {
                "cla": "0c",
                "ins": "a4",
                "p1": "02",
                "p2": "0c",
                "data": "8709016375432908c044f68e08bf8b92d635ff24f8",
