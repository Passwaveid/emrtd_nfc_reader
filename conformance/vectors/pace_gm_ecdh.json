    {
      "name": "MSE:Set AT without DO84 matches App G.1 (both runners)",
      "op": "apdu.commandBuild",
      "input": {
        "method": "sendMSESetATMutualAuth",
        "args": {
          "oid": "0.4.0.127.0.7.2.2.4.2.2",
