      "input": {
        "requested": 231,
        "maxTransceiveLength": 261,
        "smBlockSize": 8
      },
      "expect": {
        "out": {
          "length": 231
        }
      }
    },
    {
      "name": "3DES at 261: 239 (260-byte frame, the arithmetic maximum)",
      "op": "readLength.fit",
      "input": {
        "requested": 239,
        "maxTransceiveLength": 261,
        "smBlockSize": 8
      },
      "expect": {
        "out": {
          "length": 239
        }
      }
    },
    {
      "name": "3DES at 261: 240 does not fit (268) -> 239",
