{
  "suite": "read_length",
  "schemaVersion": 1,
  "description": "fitReadLength. The largest READ BINARY length whose response frame fits the transport cap, secure-messaging overhead included (DO87 1+L+1+pad(N), DO99 4, DO8E 10, SW 2; pad = ISO 9797-1 method 2 to the cipher block; L = BER width of the DO87 content). Covers the frame-size rows at the 261-byte AOSP constant and the 253-byte Broadcom-era figure, the no-SM N+2 rule and the 1024-byte extended shape. Dart-only: upstream clamps nothing (CoreNFC owned the transport).",
  "runners": [
    "dart"
  ],
  "cases": [
    {
      "name": "no SM: data + SW, 160 at 261",
      "op": "readLength.fit",
      "input": {
        "requested": 160,
        "maxTransceiveLength": 261,
        "smBlockSize": null
      },
      "expect": {
        "out": {
          "length": 160
        }
      }
    },
    {
      "name": "no SM: 256 at 261",
      "op": "readLength.fit",
      "input": {
        "requested": 256,
        "maxTransceiveLength": 261,
        "smBlockSize": null
      },
      "expect": {
        "out": {
          "length": 256
        }
      }
    },
    {
      "name": "no SM: 0x200 at 261 fits 259",
      "op": "readLength.fit",
      "input": {
        "requested": 512,
        "maxTransceiveLength": 261,
        "smBlockSize": null
      },
      "expect": {
        "out": {
          "length": 259
        }
      }
    },
    {
      "name": "no SM: 223 over a 100-byte transport fits 98",
      "op": "readLength.fit",
      "input": {
        "requested": 223,
        "maxTransceiveLength": 100,
        "smBlockSize": null
      },
      "expect": {
        "out": {
          "length": 98
        }
      }
    },
    {
      "name": "3DES at 261: 160 (188-byte frame)",
      "op": "readLength.fit",
      "input": {
        "requested": 160,
        "maxTransceiveLength": 261,
        "smBlockSize": 8
      },
      "expect": {
        "out": {
          "length": 160
        }
      }
    },
    {
      "name": "3DES at 261: 223 (244-byte frame)",
