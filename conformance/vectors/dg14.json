      },
      "expect": {
        "out": {
          "infos": [
            {
              "type": "ChipAuthenticationInfo",
              "oid": "0.4.0.127.0.7.2.2.3.2.1",
              "version": 1,
              "keyId": null
            },
            {
              "type": "ChipAuthenticationPublicKeyInfo",
              "oid": "0.4.0.127.0.7.2.2.1.2",
              "keyId": null
            }
          ]
        }
      }
