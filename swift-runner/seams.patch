diff --git a/Sources/NFCPassportReader/PACETestSeams.swift b/Sources/NFCPassportReader/PACETestSeams.swift
new file mode 100644
index 0000000..3a4e037
--- /dev/null
+++ b/Sources/NFCPassportReader/PACETestSeams.swift
@@ -0,0 +1,71 @@
+//
+//  PACETestSeams.swift
+//  NFCPassportReader
+//
+//  Test-enabling seams for the emrtd_core Dart port's PACE conformance.
+//  Mirrors Utils.swift's `_emrtdRandomSource`: injectable
+//  private scalars so deterministic PACE transcripts reproduce the exact
+//  mapping (step 2) and ephemeral (step 3) keypairs. Nil on the live path,
+//  where PACEInfo.createMappingKey / doStep3KeyExchange call
+//  EC_KEY_generate_key / DH_generate_key unchanged.
+//
+//  This file exists only on the `test-seams` branch (test-enabling
+//  changes only). First compiled/executed at rented-Mac session S3.
+//
+
+import Foundation
+import OpenSSL
+
+/// Injected step-2 *mapping* private scalar (raw big-endian bytes). Set only
+/// from the ConformanceTests target.
+public var _emrtdPaceMappingPrivateKey: [UInt8]? = nil
+
+/// Injected step-3 *ephemeral* private scalar (raw big-endian bytes).
+public var _emrtdPaceEphemeralPrivateKey: [UInt8]? = nil
+
+/// Synthesises an EC keypair from a raw private scalar: sets the private key
+/// and computes the matching public point as d·G. Returns false on any
+/// OpenSSL failure. (The Swift analogue of the Dart handler's
+/// injected `mappingPrivateKey`/`ephemeralPrivateKey`.)
+@discardableResult
+func _emrtdSetECPrivateKey(_ ecKey: OpaquePointer, scalar: [UInt8]) -> Bool {
+    guard let bn = BN_bin2bn(scalar, Int32(scalar.count), nil) else { return false }
+    defer { BN_free(bn) }
+    guard let group = EC_KEY_get0_group(ecKey),
+        let pub = EC_POINT_new(group)
+    else { return false }
+    defer { EC_POINT_free(pub) }
+    let ctx = BN_CTX_new()
+    defer { BN_CTX_free(ctx) }
+    // pub = scalar·G  (reduces mod n internally, matching pointycastle).
+    guard EC_POINT_mul(group, pub, bn, nil, nil, ctx) == 1,
+        EC_KEY_set_private_key(ecKey, bn) == 1,
+        EC_KEY_set_public_key(ecKey, pub) == 1
+    else { return false }
+    return true
+}
+
+/// Synthesises a DH keypair from a raw private scalar: sets the private key
+/// and computes the matching public value as g^x mod p. `DH_set0_key` takes
+/// ownership of both BIGNUMs on success.
+@discardableResult
+func _emrtdSetDHPrivateKey(_ dh: OpaquePointer, scalar: [UInt8]) -> Bool {
+    guard let priv = BN_bin2bn(scalar, Int32(scalar.count), nil) else { return false }
+    var p: OpaquePointer?
+    var q: OpaquePointer?
+    var g: OpaquePointer?
+    DH_get0_pqg(dh, &p, &q, &g)
+    guard let pub = BN_new() else {
+        BN_free(priv)
+        return false
+    }
+    let ctx = BN_CTX_new()
+    defer { BN_CTX_free(ctx) }
+    guard BN_mod_exp(pub, g, priv, p, ctx) == 1 else {
+        BN_free(priv)
+        BN_free(pub)
+        return false
+    }
+    guard DH_set0_key(dh, pub, priv) == 1 else { return false }
+    return true
+}
