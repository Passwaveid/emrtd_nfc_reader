@@ -0,0 +1,96 @@
+//
+//  CATestSeams.swift
+//  NFCPassportReader
+//
+//  Test-enabling seams for the emrtd_core Dart port's Chip
+//  Authentication conformance. Mirrors PACETestSeams.swift
+//  and Utils.swift's `_emrtdRandomSource`: an injectable
+//  private scalar so deterministic CA transcripts reproduce the exact
+//  ephemeral keypair. Nil on the live path, where `ChipAuthenticationHandler
+//  .doCA` calls EVP_PKEY_keygen unchanged.
+//
+//  This file exists only on the `test-seams` branch (test-enabling
+//  changes only).
+//
+
+import Foundation
+import OpenSSL
+
+/// Injected Chip Authentication *ephemeral* private scalar (raw big-endian
+/// bytes). Set only from the ConformanceTests target.
+///
+/// CA generates exactly one ephemeral keypair per attempted chip key, and the
+/// injected value is reused across the key loop; the port's seam has the
+/// same shape.
+public var _emrtdCaEphemeralPrivateKey: [UInt8]? = nil
+
+/// Builds an ephemeral keypair on `publicKey`'s own domain parameters from a
+/// raw private scalar: the deterministic stand-in for
+/// `EVP_PKEY_keygen(EVP_PKEY_CTX_new(publicKey, nil), ...)`, which is exactly
+/// what `doCA` does on the live path ("This should work for both EC and DH
+/// keys").
+///
+/// Returns nil on any OpenSSL failure, in which case the caller falls back to
+/// real key generation. Caller owns the returned EVP_PKEY.
+func _emrtdCaEphemeralKeyPair(from publicKey: OpaquePointer, scalar: [UInt8])
+    -> OpaquePointer?
+{
+    let keyType = EVP_PKEY_get_base_id(publicKey)
+    if keyType == EVP_PKEY_DH || keyType == EVP_PKEY_DHX {
+        guard let peer = EVP_PKEY_get1_DH(publicKey) else { return nil }
+        defer { DH_free(peer) }
+
+        // Copy p, q, g off the chip key: the ephemeral key must live in the
+        // same group.
+        var p: OpaquePointer?
+        var q: OpaquePointer?
+        var g: OpaquePointer?
+        DH_get0_pqg(peer, &p, &q, &g)
+        guard let p = p, let g = g,
+            let dh = DH_new(),
+            let pCopy = BN_dup(p),
+            let gCopy = BN_dup(g)
+        else { return nil }
+        let qCopy = q.flatMap { BN_dup($0) }
+        // DH_set0_pqg takes ownership of the three BIGNUMs on success.
+        guard DH_set0_pqg(dh, pCopy, qCopy, gCopy) == 1 else {
+            BN_free(pCopy)
+            BN_free(gCopy)
+            if let qCopy = qCopy { BN_free(qCopy) }
+            DH_free(dh)
+            return nil
+        }
+        guard _emrtdSetDHPrivateKey(dh, scalar: scalar) else {
+            DH_free(dh)
+            return nil
+        }
+        let pkey = EVP_PKEY_new()
+        guard EVP_PKEY_set1_DH(pkey, dh) == 1 else {
+            DH_free(dh)
+            EVP_PKEY_free(pkey)
+            return nil
+        }
+        DH_free(dh)
+        return pkey
+    }
+
+    guard let peer = EVP_PKEY_get1_EC_KEY(publicKey) else { return nil }
+    defer { EC_KEY_free(peer) }
+    guard let group = EC_KEY_get0_group(peer),
+        let ec = EC_KEY_new()
+    else { return nil }
+    guard EC_KEY_set_group(ec, group) == 1,
+        _emrtdSetECPrivateKey(ec, scalar: scalar)
+    else {
+        EC_KEY_free(ec)
+        return nil
+    }
+    let pkey = EVP_PKEY_new()
+    guard EVP_PKEY_set1_EC_KEY(pkey, ec) == 1 else {
+        EC_KEY_free(ec)
+        EVP_PKEY_free(pkey)
+        return nil
+    }
+    EC_KEY_free(ec)
+    return pkey
+}
